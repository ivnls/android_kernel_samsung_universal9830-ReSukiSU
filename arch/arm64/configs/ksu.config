# Config fragment for enabling BakaSU (KernelSU fork, formerly ReSukiSU)
# Docs: https://bakasu.org/guide/manual-integrate.html

# Enable KernelSU (built-in; manual hooks do not support LKM/=m)
CONFIG_KSU=y

# CONFIG_KSU_DEBUG is not set

# Hooking method: manual hooks (non-GKI 4.19).
# Tracepoint hook is GKI 2.0 (5.10+) only and fails the build here.
CONFIG_KSU_MANUAL_HOOK=y

# On kernels < 6.8 these are applied automatically via LSM / input_handler,
# so fs/read_write.c, kernel/sys.c and drivers/input/input.c stay untouched.
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# Allow the official KernelSU / KOWSU managers as well as BakaSU's
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# Already =y in exynos9830_defconfig; required by BakaSU, otherwise the
# static symbol export checks (services.c, selinuxfs.c) become mandatory.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# EOF
